# ------------------------------------------------------------------------------
# Django application
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DEBUG=true

# Opcional: sobrescreva os domínios usados em ALLOWED_HOSTS/CORS
SERVICE_DOMAIN=service.example.galleyops.com
APP_DOMAIN=app.example.galleyops.com
PUBLIC_SITE_DOMAIN=example.galleyops.com

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=galley_ops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis / Channels
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# NFC-e certificate and environment
# ------------------------------------------------------------------------------
CERTIFICATE_LOCATION=nfce/data/certificado.pfx
CERTIFICATE_PASSWORD=sua-senha
CERTIFICATE_UF=SC

TOKEN_HOMOLOGACAO=
TOKEN_PRODUCAO=
CSC_HOMOLOGACAO=
CSC_PRODUCAO=

# ------------------------------------------------------------------------------
# NFC-e emitter data
# ------------------------------------------------------------------------------
RAZAO_SOCIAL_EMITENTE=Sua Empresa LTDA
NOME_FANTASIA_EMITENTE=Seu Restaurante
CNPJ_EMITENTE=00000000000000
INSCRICAO_ESTADUAL_EMITENTE=000000000
CODIGO_DE_REGIME_TRIBUTARIO_EMITENTE=1
SERIE_NF_EMITENTE=10
ENDERECO_LOGRADOURO_EMITENTE=Rua Exemplo
ENDERECO_NUMERO_EMITENTE=123
ENDERECO_BAIRRO_EMITENTE=Centro
ENDERECO_MUNICIPIO_EMITENTE=Sua Cidade
ENDERECO_UF_EMITENTE=SC
ENDERECO_CEP_EMITENTE=00000000

# ------------------------------------------------------------------------------
# NFC-e technical responsible
# ------------------------------------------------------------------------------
CNPJ_RESPONSAVEL_TECNICO=00000000000000
CONTATO_RESPONSAVEL_TECNICO=Responsável Técnico
EMAIL_RESPONSAVEL_TECNICO=responsavel@example.com
FONE_RESPONSAVEL_TECNICO=00000000000

# ------------------------------------------------------------------------------
# Printer service
# ------------------------------------------------------------------------------
PRINTER_SERVER_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Telegram notifications
# ------------------------------------------------------------------------------
TELEGRAM_TOKEN=
KITCHEN_CHAT_ID=
GENERAL_CHAT_ID=

# ------------------------------------------------------------------------------
# Gunicorn / Celery
# ------------------------------------------------------------------------------
WEB_CONCURRENCY=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
CELERY_CONCURRENCY=3
